# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# REQUIRED in production (the server refuses to start without it). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# SQLite file location (defaults to server/data/finvara.db)
# DATABASE_PATH=./server/data/finvara.db

# ── AI advisors ───────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run in offline demo mode (same tools, keyword routing, no API calls).
ANTHROPIC_API_KEY=
# Any Claude model id. Admins can override at runtime under Admin → Settings.
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning depth for replies: low | medium | high
ANTHROPIC_EFFORT=medium
